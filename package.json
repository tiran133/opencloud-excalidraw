    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=throw vitest"
  },
  "devDependencies": {
    "@opencloud-eu/eslint-config": "^5.0.0",
    "@opencloud-eu/prettier-config": "^5.0.0",
    "@opencloud-eu/tsconfig": "^5.0.0",
    "@opencloud-eu/web-client": "^5.0.0",
    "@opencloud-eu/web-pkg": "^5.0.0",
    "@types/lodash.escape": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.22.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.13",
    "vue-router": "^5.0.0",
    "vue-tsc": "^3.0.0",
    "vue3-gettext": "^2.4.0"
