  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@opencloud-eu/extension-sdk": "^5.0.0",
    "idb-keyval": "^6.2.2",
    "lodash.escape": "^4.0.1",
    "lodash.throttle": "^4.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.3",
    "veaury": "^2.6.0",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@10.18.1"
