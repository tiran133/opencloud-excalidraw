  "description": "Excalidraw drawing application for OpenCloud",
  "license": "Apache-2.0",
  "author": "OpenCloud",
  "private": true,
  "homepage": "https://github.com/opencloud-eu/web-app-excalidraw",
  "type": "module",
  "scripts": {
    "build": "pnpm vite build",
    "build:w": "pnpm vite build --watch --mode development",
