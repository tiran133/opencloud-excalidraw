{
  "name": "excalidraw-collab-server",
  "version": "1.0.0",
  "description": "Socket.IO collaboration relay server for Excalidraw on OpenCloud",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc",
    "lint": "npx eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "express": "^4.21.0",
    "fast-xml-parser": "^5.7.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
